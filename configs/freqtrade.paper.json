{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "SwapTradingCheto Paper",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "max_open_trades": 2,
  "timeframe": "4h",
  "stoploss": -0.99,
  "minimal_roi": {},
  "fiat_display_currency": "",
  "fee": 0.001,
  "force_entry_enable": false,
  "position_adjustment_enable": false,
  "cancel_open_orders_on_exit": true,
  "db_url": "sqlite:////freqtrade/user_data/trades.paper.sqlite",
  "user_data_dir": "/freqtrade/user_data",
  "strategy_path": "/freqtrade/user_data/strategies",
  "exchange": {
    "name": "binance",
    "api_key": "",
    "secret": "",
    "pair_whitelist": ["BTC/USDT", "ETH/USDT"],
    "pair_blacklist": [],
    "ccxt_config": {"enableRateLimit": true},
    "ccxt_async_config": {"enableRateLimit": true}
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "order_types": {"entry": "market", "exit": "market", "stoploss": "market", "stoploss_on_exchange": false},
  "order_time_in_force": {"entry": "GTC", "exit": "GTC"},
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "telegram": {"enabled": false, "token": "", "chat_id": "", "allow_custom_messages": false},
  "api_server": {"enabled": true, "listen_ip_address": "0.0.0.0", "listen_port": 8080,
                 "verbosity": "error", "enable_openapi": false, "CORS_origins": [], "username": "lab"},
  "internals": {"process_throttle_secs": 5}
}
